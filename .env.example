NODE_ENV=development

GRAPHQL_URI=https://localhost:3000/graphql

DB_URI=mongodb+srv://<user>:<password>@<cluster-host>/
DB_NAME=pos
DB_APP=pos

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=<generate-a-unique-secret-per-environment>
NEXTAUTH_URL=https://localhost:3000

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=<generate-a-unique-secret-per-environment>

NEXT_PUBLIC_CASH_ID=<payment-method-id>
NEXT_PUBLIC_ON_ACCOUNT_ID=<payment-method-id>
NEXT_PUBLIC_STORE_CREDIT_ID=<payment-method-id>

# Register closure report email. Leave SMTP_HOST empty to switch the feature
# off - closing a register then works exactly as before, with no email.
# Gmail / Google Workspace needs an App Password (Google Account > Security >
# 2-Step Verification > App passwords), NOT the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@c-one.ph
SMTP_PASSWORD=<16-character-app-password>
SMTP_FROM=C-ONE POS <notifications@c-one.ph>

# Who gets the closing report. Comma separated.
CLOSURE_REPORT_TO=princenagac12@gmail.com
